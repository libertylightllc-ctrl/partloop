# Local-first mode. Keep true until Supabase, payments, and logistics are configured.
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: mock | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Logistics: mock | aramex
LOGISTICS_PROVIDER=mock
ARAMEX_API_BASE_URL=https://ws.aramex.net
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=AE

# Optional AI listing endpoint. The built-in deterministic assistant is used when empty.
AI_LISTING_ENDPOINT=
AI_LISTING_API_KEY=
